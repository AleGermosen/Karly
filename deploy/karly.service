[Unit]
Description=Karly — German tutor Telegram bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# %h expands to the user's home directory. Adjust if you clone elsewhere.
WorkingDirectory=%h/Karly
# Set env vars before Python starts so the DB path never depends on cwd. This
# mirrors the English unit and guarantees the German bot uses its own database.
EnvironmentFile=%h/Karly/.env
ExecStart=%h/Karly/.venv/bin/python -m bot.main
Restart=on-failure
RestartSec=5
# Give the bot a moment to shut down cleanly on stop/restart.
TimeoutStopSec=15

[Install]
WantedBy=default.target
