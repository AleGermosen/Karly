[Unit]
Description=Karly — German tutor Telegram bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# %h expands to the user's home directory. Matches karly-english.service and
# the actual OptiPlex checkout path (~/PycharmProjects/Karly, not ~/Karly —
# adjust if you clone elsewhere).
WorkingDirectory=%h/PycharmProjects/Karly
# config.py loads .env via python-dotenv on startup, so no EnvironmentFile is
# needed here (unlike karly-english.service, which uses .env.english instead
# of the default .env dotenv would pick up — this one needs no override).
ExecStart=%h/PycharmProjects/Karly/.venv/bin/python -m bot.main
Restart=on-failure
RestartSec=5
# Give the bot a moment to shut down cleanly on stop/restart.
TimeoutStopSec=15

[Install]
WantedBy=default.target
