# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Gemini API key from https://aistudio.google.com
GEMINI_API_KEY=

# Groq API key from https://console.groq.com (primary backend)
GROQ_API_KEY=

# Optional: restrict the bot to a single Telegram user id.
# If unset, the first user to /start is adopted and persisted.
ALLOWED_USER_ID=

# Gemini model (free tier)
GEMINI_MODEL=gemini-3.6-flash

# Ollama (local fallback). Model must be one you've actually `ollama pull`ed.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b-instruct-q4_K_M

# Lock this instance to a single language: "german" or "english" (hides the
# language picker). Leave blank only for a single unlocked bot.
BOT_LANGUAGE=german

# SQLite database path. CRITICAL: each bot instance MUST have its OWN database
# file. If you run both the German and English bots, give them different names
# (e.g. karly_german.db / karly_english.db) — sharing one file leaks user data,
# vocab, and conversation history across languages. The filename must contain the
# BOT_LANGUAGE value (karly_<language>.db); config.py refuses to start otherwise.
DATABASE_URL=sqlite:///karly_german.db

# --- Payments ---
# PayPal provider token from BotFather → Payments → PayPal (leave blank = Stars only).
# Steps: BotFather → /mybots → Karly → Bot Settings → Payments → PayPal
#        → follow the PayPal Business account link → copy the token BotFather gives you.
# Test token format: 123456789:TEST:...   Live token format: 123456789:LIVE:...
PAYMENT_PROVIDER_TOKEN=

# Subscription price overrides (optional — defaults match the pricing decision).
# SUBSCRIBE_PRICE_STARS=250
# SUBSCRIBE_PRICE_USD_CENTS=499
# SUBSCRIBE_DAYS=30
