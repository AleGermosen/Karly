# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Gemini API key from https://aistudio.google.com
GEMINI_API_KEY=

# Optional: restrict the bot to a single Telegram user id.
# If unset, the first user to /start is adopted and persisted.
ALLOWED_USER_ID=

# Gemini model (free tier)
GEMINI_MODEL=gemini-2.5-flash

# Ollama (INACTIVE until Phase 5 — leave as-is)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b-instruct

# SQLite database path
DATABASE_URL=sqlite:///karly.db
