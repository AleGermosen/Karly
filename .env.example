# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Gemini API key from https://aistudio.google.com
GEMINI_API_KEY=

# Optional: restrict the bot to a single Telegram user id.
# If unset, the first user to /start is adopted and persisted.
ALLOWED_USER_ID=

# Gemini model (free tier)
GEMINI_MODEL=gemini-3.6-flash

# Ollama (local fallback). Model must be one you've actually `ollama pull`ed.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b-instruct-q4_K_M

# SQLite database path
DATABASE_URL=sqlite:///karly.db
